# Necessary: the Discord bot token. Find it in the Developer Portal: your application → Bot → Reset Token.
DISCORD_TOKEN=
# The "POST to" URL and the "key" of the webhook trigger of your Grok Bot routine.
# You can start the Bridge without them. Members cannot give tasks until you set them.
GROK_BOT_ROUTINE_URL=
GROK_BOT_ROUTINE_KEY=
# Necessary: a long random value. Grok Bot sends it as "Authorization: Bearer <value>" to the MCP server.
# Make one with: openssl rand -hex 32
MCP_TOKEN=

# Optional settings
MCP_PORT=3000
MCP_HOST=0.0.0.0
# The SQLite file that keeps the tasks
DATABASE_PATH=data/tasks.sqlite
# The maximum number of tasks that bots can give each other in one conversation. 0: bots cannot give each other tasks.
MAX_BOT_STEPS=10

# More than one Discord bot: write the Discord token and the routine of each bot in a JSON file, and set its path here.
# Then remove DISCORD_TOKEN and the routine settings from this file. Keep MCP_TOKEN: all bots use it. See bridges.example.json.
# BRIDGES_FILE=bridges.json
# The maximum number of conversations that bots can start in one hour, all bots together. 0: only persons start conversations.
MAX_BOT_CONVERSATIONS_PER_HOUR=10

# Optional router: in these channels, messages that mention no bot go to the bots that they concern.
# The router is the OpenAI Decisions API. It receives the text, the author name, and the channel name of each message.
# OPENAI_API_KEY=
# ROUTER_CHANNELS=team
# ROUTER_THRESHOLD=0.6
